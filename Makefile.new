# PS4 Neon Arena Game Makefile
# Uses OpenOrbis Toolchain natively

# Project metadata
TITLE       := Neon Arena PS4
VERSION     := 2.00
TITLE_ID    := BREW00002
CONTENT_ID  := IV0000-BREW00002_00-NEONARENA0000000

# Toolchain path
TOOLCHAIN   ?= $(OO_PS4_TOOLCHAIN)
ifneq ($(TOOLCHAIN),)
TOOLCHAIN   := /workspace/PS4Toolchain
endif

# Directories
INTDIR      := build
SCE_MODULE_DIR := sce_module

# Tools
CCX         := $(TOOLCHAIN)/bin/linux/openorbis-clang++
LD          := $(TOOLCHAIN)/bin/linux/ld.lld
PKGTOOL     := $(TOOLCHAIN)/bin/linux/PkgTool.Core
CREATEFSELF := $(TOOLCHAIN)/bin/linux/create-fself
CREATEGP4   := $(TOOLCHAIN)/bin/linux/create-gp4

# Compiler flags
CFLAGS      := --target=x86_64-pc-freebsd12-elf -fPIC -funwind-tables -c \
               -isysroot $(TOOLCHAIN) \
               -isystem $(TOOLCHAIN)/include \
               -isystem /usr/include \
               -isystem /usr/include/x86_64-linux-gnu

CXXFLAGS    := $(CFLAGS) \
               -isystem $(TOOLCHAIN)/include/c++/v1 \
               -DSDL_DISABLE_MMINTRIN_H \
               -DSDL_DISABLE_XMMINTRIN_H \
               -DSDL_DISABLE_EMMINTRIN_H \
               -DSDL_DISABLE_PMMINTRIN_H \
               -DSDL_DISABLE_IMMINTRIN_H \
               -DSDL_DISABLE_3DNOW_NOW \
               -DSDL_DISABLE_3DNOW

# Linker flags
LDFLAGS     := -m elf_x86_64 -pie \
               --script $(TOOLCHAIN)/link.x \
               --eh-frame-hdr \
               -z undefs \
               -L$(TOOLCHAIN)/lib \
               -lSDL2 -lkernel -lm -lpthread -lc++ -lc \
               $(TOOLCHAIN)/lib/crt1.o

# Environment for tools
export LD_LIBRARY_PATH := /workspace/clang-local/usr/lib/x86_64-linux-gnu:$(pwd)/ssl-local/usr/lib/x86_64-linux-gnu:$(LD_LIBRARY_PATH)
export OO_PS4_TOOLCHAIN := $(TOOLCHAIN)
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT := 1

# Object files
OBJS := $(INTDIR)/main.o $(INTDIR)/ps4_stubs.o

.PHONY: all clean pkg

all: $(CONTENT_ID).pkg

pkg: $(CONTENT_ID).pkg

$(CONTENT_ID).pkg: pkg.gp4
	@echo "Building PKG..."
	$(PKGTOOL) pkg_build $< .

pkg.gp4: eboot.bin sce_sys/param.sfo sce_sys/icon0.png sce_sys/about/right.sprx sce_module/libc.prx sce_module/libSceFios2.prx
	@echo "Creating GP4 project..."
	$(CREATEGP4) -out $@ --content-id=$(CONTENT_ID) --files "$^"

sce_sys/param.sfo: Makefile
	@mkdir -p sce_sys
	@echo "Creating SFO..."
	$(PKGTOOL) sfo_new $@
	$(PKGTOOL) sfo_setentry $@ APP_TYPE --type Integer --maxsize 4 --value 1
	$(PKGTOOL) sfo_setentry $@ APP_VER --type Utf8 --maxsize 8 --value '$(VERSION)'
	$(PKGTOOL) sfo_setentry $@ ATTRIBUTE --type Integer --maxsize 4 --value 0
	$(PKGTOOL) sfo_setentry $@ CATEGORY --type Utf8 --maxsize 4 --value 'gd'
	$(PKGTOOL) sfo_setentry $@ CONTENT_ID --type Utf8 --maxsize 48 --value '$(CONTENT_ID)'
	$(PKGTOOL) sfo_setentry $@ DOWNLOAD_DATA_SIZE --type Integer --maxsize 4 --value 0
	$(PKGTOOL) sfo_setentry $@ SYSTEM_VER --type Integer --maxsize 4 --value 0
	$(PKGTOOL) sfo_setentry $@ TITLE --type Utf8 --maxsize 128 --value '$(TITLE)'
	$(PKGTOOL) sfo_setentry $@ TITLE_ID --type Utf8 --maxsize 12 --value '$(TITLE_ID)'
	$(PKGTOOL) sfo_setentry $@ VERSION --type Utf8 --maxsize 8 --value '$(VERSION)'

sce_sys/about/right.sprx: OpenOrbis/PS4Toolchain/samples/graphics/sce_sys/about/right.sprx
	@mkdir -p sce_sys/about
	@cp $< $@

sce_module/libc.prx: OpenOrbis/PS4Toolchain/samples/sce_module/libc.prx
	@cp $< $@

sce_module/libSceFios2.prx: OpenOrbis/PS4Toolchain/samples/sce_module/libSceFios2.prx
	@cp $< $@

sce_sys/icon0.png: icon0.png
	@mkdir -p sce_sys
	@cp $< $@

$(INTDIR):
	mkdir -p $(INTDIR)

$(INTDIR)/%.o: %.cpp
	@echo "Compiling $<..."
	$(CCX) $(CXXFLAGS) -o $@ $<

$(INTDIR)/%.o: %.c
	@echo "Compiling $<..."
	$(TOOLCHAIN)/bin/linux/openorbis-clang $(CFLAGS) -o $@ $<

clean:
	rm -rf $(CONTENT_ID).pkg pkg.gp4 sce_sys eboot.bin buildsce_module
